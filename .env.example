# Control plane
CELLBLOCK_HOME=~/.cellblock          # SQLite DB + template tarballs live here
CELLBLOCK_PORT=4300
CELLBLOCK_INSTANCE=default           # scopes Docker ownership; use distinct values for two control planes
CELLBLOCK_DEFAULT_IMAGE=python:3.12-slim
CELLBLOCK_ALLOWED_IMAGES=python:3.12-slim,node:22-alpine  # comma list; other images get 422
CELLBLOCK_POOL_SIZE=2                # warm containers kept ready for default-profile creates
CELLBLOCK_MAX_SANDBOXES_PER_KEY=5
CELLBLOCK_REAPER_INTERVAL=5          # seconds between TTL sweeps

# Client (SDKs and CLI)
CELLBLOCK_URL=http://127.0.0.1:4300
CELLBLOCK_API_KEY=                   # mint with: uv run cellblock key create NAME

# Examples only (keyless demo does not need these)
ANTHROPIC_API_KEY=
CELLBLOCK_MODEL=claude-sonnet-5-5
CELLBLOCK_MODEL_PROVIDER=anthropic   # set to "scripted" to force the offline transcript
